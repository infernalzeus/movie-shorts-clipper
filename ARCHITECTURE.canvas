    {"id":"e15","fromNode":"metadata","toNode":"m_narr","fromSide":"right","toSide":"left","label":"title/desc"},
    {"id":"e16","fromNode":"orch","toNode":"g_pick","fromSide":"bottom","toSide":"top"}
  ]
}
