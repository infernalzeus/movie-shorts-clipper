# Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Every render writes here — large media, never source
output/

# Personal channel identity. brand.example.json is the committed template;
# your real brand.json and artwork stay on your machine.
assets/brand/brand.json
assets/brand/avatar.*
assets/brand/banner.*

# Your music library — the pipeline reads whatever you drop in here
audio/*
!audio/.gitkeep

# Working documents for the audit, not part of the product
docs/AUDIT-PLAN.md
docs/AUDIT-SPEC.md

# Scratch and editor noise
*.bak
*.tmp
.DS_Store
Thumbs.db
